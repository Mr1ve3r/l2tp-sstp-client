## Фаза 2. Модуль `engine-api` — контракт движков

### 2.1. Задачи

Определить protocol-agnostic контракт. Ничего не реализовывать, только API.

```kotlin
package io.github.<owner>.combined.engine

/** Абстракция над VpnService.protect(). Реализуется хостом. */
fun interface SocketProtector {
    fun protect(socket: java.net.Socket): Boolean
    fun protect(socket: java.net.DatagramSocket): Boolean
    fun protect(fd: Int): Boolean
}

/** Параметры туннеля, согласованные с сервером после установки соединения. */
data class TunnelParams(
    val localAddress: java.net.InetAddress,
    val prefixLength: Int,
    val dnsServers: List<java.net.InetAddress>,
    val mtu: Int,
    val searchDomains: List<String> = emptyList(),
    val routes: List<Route> = emptyList()   // пусто = default route 0.0.0.0/0
)

data class Route(val address: java.net.InetAddress, val prefixLength: Int)

sealed interface EngineState {
    data object Idle : EngineState
    data class Connecting(val stage: String) : EngineState
    data class Connected(val params: TunnelParams, val since: Long) : EngineState
    data class Reconnecting(val attempt: Int, val cause: EngineError) : EngineState
    data class Failed(val error: EngineError) : EngineState
    data object Disconnected : EngineState
}

sealed interface EngineError {
    val messageKey: String        // ключ для локализации в UI
    val detail: String?           // техническая деталь для лога

    data class NetworkUnreachable(override val detail: String?) : EngineError { ... }
    data class AuthenticationFailed(override val detail: String?) : EngineError { ... }
    data class TlsHandshakeFailed(override val detail: String?) : EngineError { ... }
    data class CertificateRejected(
        val fingerprintSha256: String?, override val detail: String?
    ) : EngineError { ... }
    data class CertificateExpired(val notAfter: Long, override val detail: String?) : EngineError { ... }
    data class HostnameMismatch(
        val expected: String, val presented: List<String>, override val detail: String?
    ) : EngineError { ... }
    data class IpsecFailed(override val detail: String?) : EngineError { ... }
    data class PppNegotiationFailed(val phase: String, override val detail: String?) : EngineError { ... }
    data class TimedOut(val stage: String, override val detail: String?) : EngineError { ... }
    data class Internal(override val detail: String?) : EngineError { ... }
}

interface VpnEngine {
    val state: kotlinx.coroutines.flow.StateFlow<EngineState>
    val events: kotlinx.coroutines.flow.SharedFlow<EngineLogEvent>

    /**
     * Устанавливает транспорт и согласует PPP. Возвращает параметры туннеля.
     * TUN на этом этапе ещё НЕ создан — его создаёт хост по возвращённым параметрам.
     * Все сокеты обязаны быть защищены через [protector] до connect().
     */
    suspend fun connect(profile: EngineProfile, protector: SocketProtector): TunnelParams

    /** Передаёт готовый TUN. Движок начинает перекачку пакетов. */
    fun attachTun(fd: android.os.ParcelFileDescriptor)

    suspend fun disconnect()
}

data class EngineLogEvent(
    val timestamp: Long,
    val level: LogLevel,
    val protocol: Protocol,
    val tag: String,
    val message: String
)

enum class LogLevel { DEBUG, INFO, WARN, ERROR }
enum class Protocol { L2TP, SSTP }
```

`EngineProfile` — sealed-класс:

```kotlin
sealed interface EngineProfile {
    val server: String
    val username: String
    val password: String
    val mtu: Int
    val customDns: List<String>

    data class L2tp(
        override val server: String,
        override val username: String,
        override val password: String,
        override val mtu: Int,
        override val customDns: List<String>,
        val ipsecEnabled: Boolean,
        val presharedKey: String?,
        val localIdentifier: String?,
        val phase1Proposals: List<String>,
        val phase2Proposals: List<String>
    ) : EngineProfile

    data class Sstp(
        override val server: String,
        override val username: String,
        override val password: String,
        override val mtu: Int,
        override val customDns: List<String>,
        val port: Int,
        val trustPolicy: TrustPolicy,
        val expectedHostname: String?,   // переопределение SNI/verify-имени
        val minTlsVersion: TlsVersion,
        val pppAuthMethods: Set<PppAuthMethod>,
        val proxy: ProxyConfig?          // null = прямое соединение
    ) : EngineProfile
}

data class ProxyConfig(
    val host: String,
    val port: Int,
    val username: String?,
    val password: String?
)

enum class PppAuthMethod { PAP, CHAP, MSCHAPV2, EAP_MSCHAPV2 }
```

`TrustPolicy`, `TlsVersion` — объявить здесь же (без реализации проверки;
логика в `core-trust`).

**Про прокси.** SSTP идёт через HTTP CONNECT-прокси с опциональной basic-аутентификацией.
Реализация переносится из upstream (`SSLTerminal.establishProxy()`), но параметры
приходят из профиля, а не из `SharedPreferences`. Порядок установки соединения:
TCP до прокси → `CONNECT host:port` → TLS-хендшейк **с целевым сервером**, не с
прокси. Сертификат проверяется у целевого сервера; SNI — `expectedHostname ?: server`.

**Про EAP.** `EAP_MSCHAPV2` переносится из upstream и остаётся в наборе, но
**по умолчанию выключен**. MikroTik и SoftEther договариваются на MSCHAPv2
напрямую; EAP нужен для отдельных развёртываний Windows RRAS.

### 2.2. Критерии приёмки

- Модуль компилируется, не зависит ни от `engine-l2tp`, ни от `engine-sstp`,
  ни от Flutter.
- KDoc на каждом публичном типе.
- Unit-тест-заглушка `FakeVpnEngine`, реализующий интерфейс — доказательство,
